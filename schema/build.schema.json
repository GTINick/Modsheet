{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ModSheet build sheet",
  "description": "One file per car in content/builds/. The scout agent writes status draft. A human changes it to live to publish.",
  "type": "object",
  "required": [
    "status",
    "number",
    "slug",
    "chassis",
    "title",
    "summary"
  ],
  "properties": {
    "status": {
      "enum": [
        "draft",
        "soon",
        "live"
      ]
    },
    "number": {
      "type": "integer",
      "minimum": 1
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "type": {
      "enum": [
        "build",
        "concept"
      ],
      "description": "build (default): a real car. concept: a studio render, labeled Concept everywhere it appears. Needs studio, and every image needs render true."
    },
    "conceptNote": {
      "type": "string",
      "description": "Optional notice text on a concept sheet. Defaults to a line saying the car is a render and the parts are the attainable version."
    },
    "chassis": {
      "type": "string",
      "description": "Chassis code, e.g. E30, MK1, 964"
    },
    "title": {
      "type": "string",
      "description": "Year make model, e.g. 1989 BMW 325i"
    },
    "subtitle": {
      "type": "string",
      "description": "Color or spec note"
    },
    "kicker": {
      "type": "string"
    },
    "summary": {
      "type": "string",
      "maxLength": 90,
      "description": "One line for the home page card"
    },
    "thesis": {
      "type": "string",
      "description": "Two or three sentences on why this car is a great build"
    },
    "sample": {
      "type": "boolean"
    },
    "source": {
      "type": "object",
      "description": "Where the scout found it. Not published.",
      "properties": {
        "url": {
          "type": "string"
        },
        "owner": {
          "type": "string"
        },
        "permission": {
          "enum": [
            "not_asked",
            "asked",
            "granted",
            "declined"
          ]
        },
        "permissionRecord": {
          "type": "string",
          "description": "Where the written yes lives, e.g. Instagram DM 2026-10-20. Not published."
        }
      }
    },
    "photo": {
      "type": "object",
      "properties": {
        "instagram": {
          "type": "string",
          "description": "Owner's post URL. Rendered as the official embed."
        },
        "image": {
          "type": "string",
          "description": "Path to an image you have rights to use"
        },
        "alt": {
          "type": "string"
        },
        "credit": {
          "type": "string"
        },
        "creditUrl": {
          "type": "string"
        },
        "rights": {
          "enum": [
            "owned",
            "licensed",
            "permission"
          ],
          "description": "Required before a live sheet can show an image. owned: our photo or render. licensed: open license, needs license, licenseUrl, credit. permission: owner said yes in writing, needs source.permission granted and source.owner. Instagram embeds require permission."
        },
        "license": {
          "type": "string",
          "description": "License name, e.g. CC BY-SA 4.0"
        },
        "licenseUrl": {
          "type": "string"
        },
        "render": {
          "type": "boolean",
          "description": "True for a concept render. Caption reads Concept render by credit."
        }
      }
    },
    "specs": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": [
          "label",
          "value"
        ],
        "properties": {
          "label": {
            "type": "string"
          },
          "value": {
            "type": "string"
          }
        }
      }
    },
    "parts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "ref",
          "name",
          "note"
        ],
        "properties": {
          "ref": {
            "type": "string",
            "pattern": "^[A-Z]{3}-[0-9]{2}$"
          },
          "name": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "price": {
            "type": "number"
          },
          "url": {
            "type": "string",
            "description": "Product page, https only. Affiliate or not, every part should have one."
          },
          "retailer": {
            "type": "string"
          },
          "affiliate": {
            "type": "boolean",
            "description": "True when the url earns a commission. Adds rel=sponsored and an Affiliate marker."
          },
          "priceApprox": {
            "type": "boolean",
            "description": "Shows the price with a ~ when it varies or was converted."
          },
          "priceNote": {
            "type": "string",
            "description": "Short note under the price, e.g. Priced in euros."
          },
          "also": {
            "type": "array",
            "description": "Extra links, e.g. a budget alternative.",
            "items": {
              "type": "object",
              "required": [
                "label",
                "url"
              ],
              "properties": {
                "label": {
                  "type": "string"
                },
                "url": {
                  "type": "string"
                },
                "affiliate": {
                  "type": "boolean"
                }
              }
            }
          },
          "shops": {
            "type": "array",
            "description": "Several shop buttons instead of one, e.g. front and rear tires sold separately.  Each needs label, retailer and url; short is the kit button text.",
            "items": {
              "type": "object",
              "required": [
                "label",
                "url"
              ],
              "properties": {
                "label": {
                  "type": "string"
                },
                "short": {
                  "type": "string"
                },
                "retailer": {
                  "type": "string"
                },
                "url": {
                  "type": "string"
                },
                "affiliate": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      }
    },
    "bundle": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "pitch": {
          "type": "string"
        },
        "refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "detailing": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "properties": {
          "step": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "cta": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "affiliate": {
            "type": "boolean"
          }
        }
      }
    },
    "deck": {
      "type": "string",
      "description": "Standfirst under the headline on the build page. One or two sentences."
    },
    "updated": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Date prices and links were last checked, YYYY-MM-DD."
    },
    "article": {
      "type": "array",
      "description": "The build story, in order. Each section has a small label, a heading and paragraphs. image is an index into gallery.",
      "items": {
        "type": "object",
        "required": [
          "label",
          "heading",
          "body"
        ],
        "properties": {
          "label": {
            "type": "string"
          },
          "heading": {
            "type": "string"
          },
          "body": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "quote": {
            "type": "boolean",
            "description": "Show the designer's note as a pull quote after this section."
          },
          "image": {
            "type": "integer",
            "minimum": 0
          },
          "caption": {
            "type": "string"
          }
        }
      }
    }
  }
}
